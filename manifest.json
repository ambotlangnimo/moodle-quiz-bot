{
  "manifest_version": 3,
  "name": "Moodle Quiz Bot",
  "version": "3.1.0",
  "description": "Faithful reimplementation of the Python+Playwright Moodle quiz bot as a Manifest V3 extension.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.amaes.com/*",
    "https://amaes.com/*",
    "https://amauoed.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://html.duckduckgo.com/*",
    "https://en.wikipedia.org/*",
    "http://127.0.0.1:11434/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.freellmapi.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.amaes.com/*"],
      "css": ["hud.css"],
      "js": ["config.js", "storage.js", "providers.js", "content.js", "mascot.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hud.css", "mascot/*"],
      "matches": ["https://*.amaes.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moodle Quiz Bot"
  }
}