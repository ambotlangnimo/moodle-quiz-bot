{
  "manifest_version": 3,
  "name": "Moodle Quiz Bot",
  "version": "3.6.0",
  "description": "Moodle quiz bot + universal Q&A harvester with a pure-JS pixel-art cat mascot on every site.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.amaes.com/*"],
      "css": ["hud.css"],
      "js": ["config.js", "storage.js", "providers.js", "content.js", "mascot.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://*.amaes.com/*"],
      "css": ["hud.css"],
      "js": ["config.js", "storage.js", "universal-harvester.js", "mascot.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hud.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moodle Quiz Bot"
  }
}